# Sjabloon systemd-unit — mag in git, bevat geen echte waarden.
#
# Installeren:
#   sudo cp chb-pg-tunnel.service /etc/systemd/system/
#   # ExecStart hieronder aanpassen naar het echte pad van pg-tunnel.sh op de server
#   # EnvironmentFile hieronder aanpassen naar het echte pad van pg-tunnel.env (zie .example)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chb-pg-tunnel
#
# chb-viewer (de app-service) moet hier ná starten, anders faalt de eerste Hikari-connect:
#   voeg in chb-viewer's eigen unit toe: After=chb-pg-tunnel.service
#                                        Wants=chb-pg-tunnel.service

[Unit]
Description=SSH-tunnel naar de remote Postgres-server voor chb-viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_ME
EnvironmentFile=/home/REPLACE_ME/pg-tunnel.env
ExecStart=/pad/naar/deploy/pg-tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
