# Sjabloon — bevat GEEN echte waarden, mag in git.
#
# Kopieer dit naar de server, buiten de repo (bv. $HOME/pg-tunnel.env), vul in en zet chmod 600:
#
#   cp pg-tunnel.env.example ~/pg-tunnel.env
#   chmod 600 ~/pg-tunnel.env
#
# Test eerst handmatig:
#   set -a; source ~/pg-tunnel.env; set +a; ./pg-tunnel.sh
#
# Draai daarna permanent via systemd, zie chb-pg-tunnel.service in dezelfde map
# (EnvironmentFile=~/pg-tunnel.env).

PG_TUNNEL_USER=REPLACE_ME
PG_TUNNEL_HOST=db.example.com
PG_TUNNEL_SSH_PORT=22
PG_TUNNEL_REMOTE_PORT=5432
PG_TUNNEL_LOCAL_PORT=5432
PG_TUNNEL_KEY=/home/REPLACE_ME/.ssh/id_ed25519
